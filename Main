local countLabel=row("TextLabel","Spawned eggs: 0")
local function updateCount()
    local count=0
    for model in pairs(spawnedEggs) do if model.Parent then count=count+1 else spawnedEggs[model]=nil end end
    countLabel.Text="Spawned eggs: "..count
end
local function visibleBounds(model)
    local lo=Vector3.new(math.huge,math.huge,math.huge)
    local hi=Vector3.new(-math.huge,-math.huge,-math.huge)
    for _,part in ipairs(model:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency<1 then
            for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
                local point=part.CFrame:PointToWorldSpace(part.Size*Vector3.new(x,y,z)*0.5)
                lo=Vector3.new(math.min(lo.X,point.X),math.min(lo.Y,point.Y),math.min(lo.Z,point.Z))
                hi=Vector3.new(math.max(hi.X,point.X),math.max(hi.Y,point.Y),math.max(hi.Z,point.Z))
            end end end
        end
    end
    assert(lo.X~=math.huge,"Model has no visible geometry.")
    return lo,hi
end
local function seatModel(model,position)
    local lo,hi=visibleBounds(model)
    model:PivotTo(model:GetPivot()+position-Vector3.new((lo.X+hi.X)/2,lo.Y,(lo.Z+hi.Z)/2))
end
local function prepareModel(model)
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BaseScript") or obj:IsA("ProximityPrompt") then obj:Destroy()
        elseif obj:IsA("BasePart") then obj.Anchored=true; obj.CanCollide=false; obj.CanTouch=false; obj.CanQuery=false end
    end
end
local function addStealPrompt(model)
    local target=model:FindFirstChild("Hitbox",true)
        or model:FindFirstChild("HitBox",true)
        or model:FindFirstChild("Handle",true)
        or model:FindFirstChildWhichIsA("BasePart",true)
    assert(target and target:IsA("BasePart"),"Egg prompt needs a BasePart.")
    local prompt=make("ProximityPrompt",{
        Name="AuraStealPrompt",
        ActionText="Steal",
        ObjectText="Egg",
        KeyboardKeyCode=Enum.KeyCode.E,
        GamepadKeyCode=Enum.KeyCode.ButtonX,
        HoldDuration=1.2,
        MaxActivationDistance=9,
        RequiresLineOfSight=false,
        ClickablePrompt=true,
        Exclusivity=Enum.ProximityPromptExclusivity.OnePerButton,
        Style=Enum.ProximityPromptStyle.Default,
    },target)
    prompt.Triggered:Connect(function(triggeringPlayer)
        if triggeringPlayer==player then
            egg=model
            report("Egg selected for the next Bot Heist.")
        end
    end)
    return prompt
end
local function decorateEgg(model,position)
    local assets=RS:FindFirstChild("Assets")
    if useDivine then
        local particles=assets and assets:FindFirstChild("Particles")
        local rarity=particles and particles:FindFirstChild("EggRarityVFX")
        local source=rarity and rarity:FindFirstChild("RarityNumber9+")
        local hitbox=model:FindFirstChild("Hitbox",true) or model:FindFirstChild("HitBox",true)
        if source and hitbox and hitbox:IsA("BasePart") then
            local holder=Instance.new("Model")
            for _,child in ipairs(source:GetChildren()) do child:Clone().Parent=holder end
            holder:ScaleTo(hitbox.Size.Y/math.max(tonumber(source:GetAttribute("HitboxSizeY")) or 5,1))
            for _,obj in ipairs(holder:GetDescendants()) do
                if obj:IsA("ParticleEmitter") or obj:IsA("Trail") or obj:IsA("Beam") or obj:IsA("Light") then obj.Enabled=true end
            end
            for _,child in ipairs(holder:GetChildren()) do child.Parent=hitbox end
            holder:Destroy()
        end
    end
    if not useNests then return end
    local objects=workspace:FindFirstChild("__OBJECTS")
    local areas=objects and objects:FindFirstChild("Areas")
    local guards=areas and areas:FindFirstChild("GuardAreas")
    local source=guards and guards:FindFirstChild("NestModel",true)
    if not source or not source:IsA("Model") then return end
    local nest=source:Clone()
    local ok,err=pcall(function()
        prepareModel(nest)
        local lo,hi=visibleBounds(model)
        local nlo,nhi=visibleBounds(nest)
        local span=hi-lo; local nspan=nhi-nlo
        nest:ScaleTo(nest:GetScale()*math.max(span.X,span.Z)*1.2/math.max(nspan.X,nspan.Z,0.01))
        seatModel(nest,position)
        nest.Name="AuraNest"; nest.Parent=world
        local seat=nest:FindFirstChild("EggSpotBottom",true)
        local _,top=visibleBounds(nest)
        local seatY=seat and seat:IsA("BasePart") and math.max(position.Y,seat.Position.Y) or top.Y
        seatModel(model,Vector3.new(position.X,seatY,position.Z))
        eggNests[model]=nest
    end)
    if not ok then nest:Destroy(); warn("Aura nest: "..tostring(err)) end
end
local function spawnEgg(positionOverride)
    local eggScale=readEggScale()
    local position=positionOverride or ground(root().Position)
    local assets=RS:FindFirstChild("Assets")
    local models=assets and assets:FindFirstChild("Models")
    local eggs=models and models:FindFirstChild("Eggs")
    local template=eggs and eggs:FindFirstChild(choices[selected][2])
    assert(template, "Selected egg asset is unavailable in this place.")
    local clone=template:Clone()
    if not clone:IsA("Model") then
        local wrapper=Instance.new("Model"); clone.Parent=wrapper; clone=wrapper
    end
    for _,obj in ipairs(clone:GetDescendants()) do
        if obj:IsA("BaseScript") or obj:IsA("ProximityPrompt") then obj:Destroy()
        elseif obj:IsA("BasePart") then obj.Anchored=true; obj.CanCollide=false; obj.CanTouch=false; obj.CanQuery=false end
    end
    assert(clone:FindFirstChildWhichIsA("BasePart",true), "Egg template contains no parts.")
    -- Keep the authored orientation, including the rotated primary-part PivotOffset.
    -- Replacing it with an identity rotation was tipping the Demonic Egg sideways.
    -- Match the reference script: preserve every egg's authored proportions
    -- and enlarge the complete model uniformly by four times.
    clone:ScaleTo(clone:GetScale()*eggScale)
    local minY=math.huge
    local minX,minZ,maxX,maxZ=math.huge,math.huge,-math.huge,-math.huge
    for _,part in ipairs(clone:GetDescendants()) do
        if part:IsA("BasePart") and part.Transparency<1 then
            for x=-1,1,2 do for y=-1,1,2 do for z=-1,1,2 do
                local p=part.CFrame:PointToWorldSpace(part.Size*Vector3.new(x,y,z)*0.5)
                minY=math.min(minY,p.Y); minX=math.min(minX,p.X); maxX=math.max(maxX,p.X)
                minZ=math.min(minZ,p.Z); maxZ=math.max(maxZ,p.Z)
            end end end
        end
    end
    if minY==math.huge then clone:Destroy(); error("Egg has no visible geometry.") end
    local shift=position-Vector3.new((minX+maxX)/2,minY,(minZ+maxZ)/2)
    clone:PivotTo(clone:GetPivot()+shift)
    egg=clone; egg.Name="AuraEgg"; egg.Parent=world; spawnedEggs[egg]=true
    egg:SetAttribute("AuraGround",position)
    decorateEgg(egg,position)
    addStealPrompt(egg)
    updateCount()
    report("Spawned "..choices[selected][1])
    return egg
end
button("Spawn selected egg here",function() spawnEgg() end)
button("Spawn batch in front",function()
    local quantity=tonumber(quantityBox.Text)
    assert(quantity and quantity>=1 and quantity<=100 and quantity%1==0,"Choose 1 to 100 eggs per batch. Repeat for more.")
    local cf=root().CFrame
    local token=generation
    local columns=math.min(quantity,5)
    local stride=math.max(12,28*(readEggScale()/4))
    for index=1,quantity do
        if not alive or token~=generation then return end
        local column=(index-1)%columns
        local rowIndex=math.floor((index-1)/columns)
        local spot=cf.Position+cf.RightVector*((column-(columns-1)/2)*stride)+cf.LookVector*(16+rowIndex*stride)
        spawnEgg(ground(spot))
        if index%5==0 then Run.Heartbeat:Wait() end
    end
    report("Spawned "..quantity.." eggs.")
end)
button("Despawn all eggs",function() clearScene(); updateCount(); report("All eggs removed. Bot scene cancelled.") end)
section("02 / BOT HEIST")
local botName=input("Bot avatar username")
local botSpeed=input("Bot speed in studs/second")
botSpeed.Text="80"
button("Set bot start here", function() startPoint=ground(root().Position); report("Bot start saved. Move away to place the egg.") end)
button("Run bot → steal egg → return", function()
    if not egg or not egg.Parent then egg=next(spawnedEggs) end
    assert(egg and egg.Parent, "Spawn an egg first.")
    assert(not bot, "A bot scene is already running.")
    local speed=tonumber(botSpeed.Text)
    assert(speed and speed>=1 and speed<=300,"Bot speed must be between 1 and 300.")
    local token=generation
    local targetEgg=egg
    local eggRotation=targetEgg:GetPivot().Rotation
    local name=username(botName)
    report("Loading bot avatar…")
    local actor=avatar(name)
    if not alive or token~=generation or not targetEgg.Parent then actor:Destroy(); return end
    bot=actor; actor.Parent=world
    local origin=startPoint or ground(root().Position+root().CFrame.LookVector*30)
    local eggPosition=targetEgg:GetAttribute("AuraGround") or ground(targetEgg:GetPivot().Position)
    local towards=Vector3.new(eggPosition.X-origin.X,0,eggPosition.Z-origin.Z)
    local _,eggSize=targetEgg:GetBoundingBox()
    local standOff=math.min(math.max(eggSize.X,eggSize.Z)/2+2,math.max(0,towards.Magnitude-1))
    local destination=ground(eggPosition-(towards.Magnitude>0.01 and towards.Unit*standOff or Vector3.zero))
    local height=actor.Humanoid.HipHeight+actor.HumanoidRootPart.Size.Y/2
    local pivotOffset=actor.HumanoidRootPart.CFrame:ToObjectSpace(actor:GetPivot())
    actor:PivotTo(CFrame.new(origin+Vector3.new(0,height,0))*pivotOffset)
    local runTrack,idleTrack,carryTrack,trail
    local carryLo,carryHi=visibleBounds(targetEgg)
    local carryHalfHeight=(carryHi.Y-carryLo.Y)/2
    local carryPivotOffset=targetEgg:GetPivot().Position-(carryLo+carryHi)/2
    local function carryCFrame()
        local r=actor.HumanoidRootPart
        local facing=r.CFrame.Rotation
        local center=r.Position+r.CFrame.LookVector*(math.max(eggSize.X,eggSize.Z)/2+1.3)
            +Vector3.new(0,math.max(0,carryHalfHeight-height+0.5),0)
        return CFrame.new(center+facing:VectorToWorldSpace(carryPivotOffset))*facing*eggRotation
    end
    local function travel(a,b,carry)
        local duration=math.max((b-a).Magnitude/speed,0.01)
        idleTrack:Stop(0.1)
        runTrack:Play(0.1,1,math.clamp(speed/32,1,2.5))
        trail.Enabled=true
        local elapsed=0
        while elapsed<duration do
            elapsed=elapsed+Run.Heartbeat:Wait()
            if not alive or token~=generation or not actor.Parent then return false end
            local pos=ground(a:Lerp(b,math.min(elapsed/duration,1)))+Vector3.new(0,height,0)
            local direction=Vector3.new(b.X-a.X,0,b.Z-a.Z)
            local cf=direction.Magnitude>0.01 and CFrame.lookAt(pos,pos+direction) or CFrame.new(pos)
            actor:PivotTo(cf*pivotOffset)
            if carry and targetEgg.Parent then targetEgg:PivotTo(carryCFrame()) end
        end
        runTrack:Stop(0.12); idleTrack:Play(0.12); trail.Enabled=false
        return true
    end
    local ok,err=pcall(function()
        runTrack=loadTrack(actor,2510198475,Enum.AnimationPriority.Movement)
        idleTrack=loadTrack(actor,2510197257,Enum.AnimationPriority.Idle)
        carryTrack=loadTrack(actor,507768375,Enum.AnimationPriority.Action)
        trail=addTrail(actor)
        report(name.." is running to the egg…")
        if not travel(origin,destination,false) then return end
        report(name.." is picking up the egg...")
        local stealPrompt=targetEgg:FindFirstChild("AuraStealPrompt",true)
        if stealPrompt then stealPrompt:Destroy() end
        idleTrack:Stop(0.15)
        carryTrack:Play(0.25)
        local pickupStart=targetEgg:GetPivot()
        local pickupTime=os.clock()
        local deadline=os.clock()+2
        while os.clock()<deadline do
            Run.Heartbeat:Wait()
            if not alive or generation~=token or not targetEgg.Parent then return end
            local alpha=math.clamp((os.clock()-pickupTime-0.3)/1.2,0,1)
            alpha=alpha*alpha*(3-2*alpha)
            targetEgg:PivotTo(pickupStart:Lerp(carryCFrame(),alpha))
        end
        -- The nest is a separate scene object and intentionally remains behind.
        report(name.." stole the egg!")
        if not travel(destination,origin,true) then return end
        if targetEgg.Parent then targetEgg:Destroy() end
        spawnedEggs[targetEgg]=nil
        if egg==targetEgg then egg=next(spawnedEggs) end
        updateCount()
        report("Bot returned and despawned.")
    end)
    if runTrack then runTrack:Stop(); runTrack:Destroy() end
    if idleTrack then idleTrack:Stop(); idleTrack:Destroy() end
    if carryTrack then carryTrack:Stop(); carryTrack:Destroy() end
    actor:Destroy()
    if bot==actor then bot=nil end
    if not ok then error(err) end
end)
button("Cancel bot / clear scene", function() clearScene(); updateCount(); report("Scene cleared.") end)
section("03 / LOCAL IDENTITY")
local aliasBox=input("Name for announcements only")
button("Apply announcement name", function()
    local value=aliasBox.Text:match("^%s*(.-)%s*$")
    assert(#value>0 and #value<=40, "Use a name between 1 and 40 characters.")
    alias=value
    report("Announcement name set to "..alias)
end)
local morphName=input("Avatar username to morph into")
button("Morph into avatar", function()
    assert(not morphBusy,"Wait for the avatar to finish loading.")
    local name=username(morphName)
    local character=player.Character
    local humanoid=character and character:FindFirstChildOfClass("Humanoid")
    local actualRoot=character and character:FindFirstChild("HumanoidRootPart")
    assert(humanoid and actualRoot and humanoid.Health>0,"Wait for your character to spawn.")
    local version=morphVersion
    local model
    morphBusy=true
    report("Loading complete local avatar...")
    local ok,err=pcall(function()
        model=Players:CreateHumanoidModelFromUserIdAsync(Players:GetUserIdFromNameAsync(name))
        if not alive or version~=morphVersion or player.Character~=character then model:Destroy(); model=nil; return end
        local visualHumanoid=model:FindFirstChildOfClass("Humanoid")
        local visualRoot=model:FindFirstChild("HumanoidRootPart")
        assert(visualHumanoid and visualRoot,"The avatar service returned an incomplete model.")
        local targetDescription=visualHumanoid:GetAppliedDescription()
        local visualParts={}
        for _,obj in ipairs(model:GetDescendants()) do
            if obj:IsA("BaseScript") then obj:Destroy()
            elseif obj:IsA("BasePart") then
                obj.CanTouch=false; obj.CanQuery=false
                obj.Anchored=false
                obj.CanCollide=false
                obj.Massless=true
                table.insert(visualParts,obj)
            end
        end
        visualRoot.CanCollide=false
        visualRoot.Anchored=true
        visualHumanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
        visualHumanoid.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
        visualHumanoid.AutoRotate=false
        visualHumanoid.BreakJointsOnDeath=false
        visualHumanoid.PlatformStand=true
        pcall(function() visualHumanoid.EvaluateStateMachine=false end)
        visualHumanoid:ChangeState(Enum.HumanoidStateType.Physics)
        local visualIsR15=visualHumanoid.RigType==Enum.HumanoidRigType.R15
        local heightOffset=rootClearance(model,visualHumanoid,visualRoot)-rootClearance(character,humanoid,actualRoot)
        -- Preserve Roblox's generated Shirt/Pants/ShirtGraphic instances, but
        -- remove the extra Humanoid so game character systems cannot target it.
        visualHumanoid:Destroy()
        make("AnimationController",{Name="AuraAnimationController"},model)
        restore()
        local state={
            model=model,
            character=character,
            humanoid=humanoid,
            hidden={},
            connections={},
            tracks={},
            nameDistance=humanoid.DisplayDistanceType,
        }
        morphState=state
        model.Name="AuraMorph_"..player.UserId
        visualRoot.CFrame=actualRoot.CFrame+Vector3.new(0,heightOffset,0)
        -- Camera descendants render normally but do not participate in the
        -- live map's character scans and physics interactions.
        model.Parent=workspace.CurrentCamera or world
        local function hidePart(obj)
            if obj:IsA("BasePart") then
                state.hidden[obj]=obj.LocalTransparencyModifier
                obj.LocalTransparencyModifier=1
            end
        end
        for _,obj in ipairs(character:GetDescendants()) do hidePart(obj) end
        humanoid.DisplayDistanceType=Enum.HumanoidDisplayDistanceType.None
        task.defer(applyNameTag,model)
        local r15=visualIsR15
        local function chosen(value,fallback) return value and value>0 and value or fallback end
        state.tracks.idle=loadTrack(model,chosen(targetDescription.IdleAnimation,r15 and 2510197257 or 180435571),Enum.AnimationPriority.Idle)
        state.tracks.run=loadTrack(model,chosen(targetDescription.RunAnimation,r15 and 2510198475 or 180426354),Enum.AnimationPriority.Movement)
        state.tracks.jump=loadTrack(model,chosen(targetDescription.JumpAnimation,r15 and 2510197830 or 125750702),Enum.AnimationPriority.Action)
        state.tracks.fall=loadTrack(model,chosen(targetDescription.FallAnimation,r15 and 2510195892 or 180436148),Enum.AnimationPriority.Movement)
        targetDescription:Destroy()
        local current
        local function play(which)
            if current==which then return end
            for key,track in pairs(state.tracks) do if key~=which and track.IsPlaying then track:Stop(0.12) end end
            current=which
            local track=state.tracks[which]
            if track then track.Looped=which~="jump"; track:Play(0.12) end
        end
        table.insert(state.connections,Run.RenderStepped:Connect(function()
        local function syncVisual()
            if morphState~=state or player.Character~=character or not actualRoot.Parent then restore(); return end
            local camera=workspace.CurrentCamera
            if camera and model.Parent~=camera then model.Parent=camera end
            visualRoot.CFrame=actualRoot.CFrame+Vector3.new(0,heightOffset,0)
            visualRoot.AssemblyLinearVelocity=Vector3.zero
            visualRoot.AssemblyAngularVelocity=Vector3.zero
            for _,part in ipairs(visualParts) do
                if part.Parent then
                    part.CanCollide=false
                    part.CanTouch=false
                    part.CanQuery=false
                    part.Massless=true
                end
            end
            visualRoot.Anchored=true
            visualRoot.CFrame=actualRoot.CFrame+Vector3.new(0,heightOffset,0)
        end
        -- Run collision isolation before physics, then refresh the pose for the
        -- rendered frame. This prevents one-frame accessory contacts.
        table.insert(state.connections,Run.PreSimulation:Connect(syncVisual))
        table.insert(state.connections,Run.RenderStepped:Connect(function()
            if morphState~=state or player.Character~=character or not actualRoot.Parent then return end
            visualRoot.CFrame=actualRoot.CFrame+Vector3.new(0,heightOffset,0)
            for part in pairs(state.hidden) do
                if part.Parent then part.LocalTransparencyModifier=1 end
            end
            local humanState=humanoid:GetState()
            if humanState==Enum.HumanoidStateType.Jumping then play("jump")
            elseif humanState==Enum.HumanoidStateType.Freefall then play("fall")
            elseif Vector3.new(actualRoot.AssemblyLinearVelocity.X,0,actualRoot.AssemblyLinearVelocity.Z).Magnitude>0.8 then
                play("run")
                if state.tracks.run then state.tracks.run:AdjustSpeed(math.clamp(actualRoot.AssemblyLinearVelocity.Magnitude/16,0.65,2.5)) end
            else play("idle") end
        end))
        table.insert(state.connections,humanoid.Died:Connect(function() if morphState==state then restore() end end))
        report("Local avatar overlay active: "..name)
        model=nil -- ownership transferred to morphState
    end)
    if model then
        if morphState and morphState.model==model then restore() else model:Destroy() end
    end
    morphBusy=false
    if not ok then error(err) end
end)
button("Restore original avatar", function()
    if restore() then report("Original appearance restored.") end
end)
section("04 / EDITABLE NAMETAG")
local tagTextInput=input("Nametag text")
tagTextInput.Text="👑CREATOR"
local tagColorInput=input("Color: #FF0000 or 255,0,0")
tagColorInput.Text="#FF0000"
local tagPreview=row("TextLabel","👑CREATOR")
tagPreview.TextColor3=Color3.fromRGB(255,0,0)
tagPreview.TextStrokeColor3=Color3.new(0,0,0)
tagPreview.TextStrokeTransparency=0
tagPreview.Font=Enum.Font.GothamBlack
local function refreshTagPreview()
    local text=tagTextInput.Text:match("^%s*(.-)%s*$")
    tagPreview.Text=(text~="" and text or "👑CREATOR")
    local ok,color=pcall(parseTagColor,tagColorInput.Text)
    if ok then tagPreview.TextColor3=color end
end
tagTextInput:GetPropertyChangedSignal("Text"):Connect(refreshTagPreview)
tagColorInput:GetPropertyChangedSignal("Text"):Connect(refreshTagPreview)
