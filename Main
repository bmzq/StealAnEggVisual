local sizeBox=input("Egg scale (0.25 to 10)")
sizeBox.Text="4"
local function readEggScale()
    local value=tonumber(sizeBox.Text)
    assert(value and value==value and value>=0.25 and value<=10,"Egg scale must be from 0.25 to 10.")
    return value
end
