    tagTextInput.Text="👑CREATOR"; tagColorInput.Text="#FF0000"
    nameTagState.text="👑CREATOR"; nameTagState.color=Color3.fromRGB(255,0,0); nameTagState.enabled=true
    refreshTagPreview(); applyNameTag((morphState and morphState.model) or player.Character)
    report("Red CREATOR nametag applied.")
end)
button("Remove nametag",function()
    nameTagState.enabled=false; clearNameTag(); report("Nametag removed.")
end)
section("05 / ADMIN ANNOUNCEMENT")
local badgeButton
badgeButton=button("Verified badge: Auto",function()
    badgeMode=badgeMode=="Auto" and "On" or badgeMode=="On" and "Off" or "Auto"
    badgeButton.Text="Verified badge: "..badgeMode
end)
local verifiedCache={}
local function hasBadge(name)
    if badgeMode=="On" then return true end
    if badgeMode=="Off" then return false end
    local key=string.lower(name)
    if verifiedCache[key]~=nil then return verifiedCache[key] end
    local ok,result=pcall(function()
        local id=name==player.DisplayName and player.UserId or Players:GetUserIdFromNameAsync(name)
        for _,info in ipairs(UserService:GetUserInfosByUserIdsAsync({id})) do
            if info.Id==id then return info.HasVerifiedBadge==true end
        end
        error("No user information returned")
    end)
    if ok then verifiedCache[key]=result; return result end
    return false
end
local recipient=input("Username to receive simulated admin")
button("Show admin announcement", function()
    local name=username(recipient)
    Players:GetUserIdFromNameAsync(name)
    if not alive then return end
    local function escape(text)
        return (text:gsub("&","&amp;"):gsub("<","&lt;"):gsub(">","&gt;"))
    end
    local sender=alias
    local verified=hasBadge(sender)
    if not alive then return end
    local badge=verified and (" "..utf8.char(0xE000)) or ""
    local text=sender..badge.." has given "..name.." admin!"
    local client=RS:FindFirstChild("Client")
    local notifications=client and client:FindFirstChild("Notifications")
    local module=notifications and notifications:FindFirstChild("Message")
    local ok=false
    if module then
        ok=pcall(function() require(module).Top({ShowShadow=true,Message=escape(text),Time=6,Color=Color3.new(1,1,1)}) end)
    end
    if not ok then
        local banner=make("TextLabel",{AnchorPoint=Vector2.new(0.5,0),Position=UDim2.fromScale(0.5,0.08),Size=UDim2.new(0.8,0,0,60),BackgroundColor3=Color3.fromRGB(20,23,33),Text=text,TextWrapped=true,TextSize=22,Font=Enum.Font.GothamBold,TextColor3=Color3.new(1,1,1)},gui)
        make("UICorner",{CornerRadius=UDim.new(0,8)},banner)
        task.delay(6,function() banner:Destroy() end)
    end
    report("Announcement shown locally.")
end)
local toggle=make("TextButton",{Position=UDim2.fromOffset(20,12),Size=UDim2.fromOffset(140,32),Text="Aura Visuals",TextSize=14,Font=Enum.Font.Gotham,TextColor3=Color3.new(1,1,1),BackgroundColor3=Color3.fromRGB(61,44,91)},gui)
make("UICorner",{CornerRadius=UDim.new(0,8)},toggle)
make("UIStroke",{Color=Color3.fromRGB(163,119,255),Transparency=0.35},toggle)
local toggleScale=make("UIScale",{Scale=1},toggle)
local panelScale=make("UIScale",{Scale=1},panel)
toggle.MouseEnter:Connect(function() Tween:Create(toggle,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(91,58,137)}):Play() end)
toggle.MouseLeave:Connect(function() Tween:Create(toggle,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(61,44,91)}):Play() end)
toggle.MouseButton1Down:Connect(function() Tween:Create(toggleScale,TweenInfo.new(0.08),{Scale=0.96}):Play() end)
toggle.MouseButton1Up:Connect(function() Tween:Create(toggleScale,TweenInfo.new(0.12,Enum.EasingStyle.Back),{Scale=1}):Play() end)
toggle.Activated:Connect(function()
    panel.Visible=not panel.Visible
    if panel.Visible then
        panelScale.Scale=0.94
        Tween:Create(panelScale,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
    end
end)
table.insert(connections,UIS.InputBegan:Connect(function(inputObject,processed)
    if processed or UIS:GetFocusedTextBox() then return end
    if inputObject.KeyCode==Enum.KeyCode.V then
        panel.Visible=not panel.Visible
        if panel.Visible then
            panelScale.Scale=0.94
            Tween:Create(panelScale,TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Scale=1}):Play()
        end
    end
end))
table.insert(connections, player.CharacterAdded:Connect(function(character)
    restore()
    if nameTagState.enabled then task.defer(applyNameTag,character) end
    clearScene(); updateCount()
end))
local dragging,dragOrigin,panelOrigin
local function clampPosition(x,y)
    local camera=workspace.CurrentCamera
    local size=camera and camera.ViewportSize or Vector2.new(800,600)
    return UDim2.fromOffset(math.clamp(x,0,math.max(0,size.X-panel.AbsoluteSize.X)),math.clamp(y,0,math.max(0,size.Y-panel.AbsoluteSize.Y-36)))
end
title.InputBegan:Connect(function(inputObject)
    if inputObject.UserInputType==Enum.UserInputType.MouseButton1 or inputObject.UserInputType==Enum.UserInputType.Touch then
        dragging=inputObject; dragOrigin=inputObject.Position; panelOrigin=panel.Position
    end
end)
table.insert(connections,UIS.InputChanged:Connect(function(inputObject)
    if dragging and (inputObject==dragging or inputObject.UserInputType==Enum.UserInputType.MouseMovement) then
        local delta=inputObject.Position-dragOrigin
        panel.Position=clampPosition(panelOrigin.X.Offset+delta.X,panelOrigin.Y.Offset+delta.Y)
    end
end))
table.insert(connections,UIS.InputEnded:Connect(function(inputObject) if inputObject==dragging then dragging=nil end end))
local function resize()
    local camera=workspace.CurrentCamera
    if camera then panel.Size=UDim2.fromOffset(math.min(420,camera.ViewportSize.X-40),math.min(650,camera.ViewportSize.Y-90)); panel.Position=clampPosition(panel.Position.X.Offset,panel.Position.Y.Offset) end
end
panel.Position=UDim2.fromOffset(20,54)
resize()
if workspace.CurrentCamera then table.insert(connections,workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(resize)) end
gui.Destroying:Connect(function()
    alive=false
    clearNameTag()
    for _,connection in ipairs(connections) do connection:Disconnect() end
    clearScene(); restore()
    world:Destroy()
end)
button("Unload GUI and restore", function() gui:Destroy() end)
