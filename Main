local function clearNameTag()
    if activeNameTag then activeNameTag:Destroy(); activeNameTag=nil end
end
local function applyNameTag(character)
    clearNameTag()
    if not nameTagState.enabled or not character then return end
    local head=character:FindFirstChild("Head") or character:WaitForChild("Head",5)
    if not head then return end
    for _,tagName in ipairs({"CreatorTag","CartiCreatorTag","AuraEditableNameTag"}) do
        local oldTag=head:FindFirstChild(tagName)
        if oldTag then oldTag:Destroy() end
    end
    local billboard=make("BillboardGui",{
        Name="AuraEditableNameTag",
        Adornee=head,
        AlwaysOnTop=true,
        LightInfluence=0,
        MaxDistance=150,
        Size=UDim2.fromOffset(300,48),
        StudsOffsetWorldSpace=Vector3.new(0,3.25,0),
    },head)
    local label=make("TextLabel",{
        Name="Name",
        Size=UDim2.fromScale(1,1),
        BackgroundTransparency=1,
        Text=nameTagState.text,
        TextColor3=nameTagState.color,
        TextStrokeColor3=Color3.new(0,0,0),
        TextStrokeTransparency=0,
        Font=Enum.Font.GothamBlack,
        TextSize=25,
        TextScaled=false,
    },billboard)
    make("UIStroke",{Color=Color3.new(0,0,0),Thickness=1.5},label)
    activeNameTag=billboard
end
local function parseTagColor(text)
    local value=text:match("^%s*(.-)%s*$")
    local hex=value:gsub("#","")
    if hex:match("^[%x][%x][%x][%x][%x][%x]$") then
        return Color3.fromRGB(
            tonumber(hex:sub(1,2),16),
            tonumber(hex:sub(3,4),16),
            tonumber(hex:sub(5,6),16)
        )
    end
    local r,g,b=value:match("^(%d+)%s*,%s*(%d+)%s*,%s*(%d+)$")
    r,g,b=tonumber(r),tonumber(g),tonumber(b)
    if r and g and b and r<=255 and g<=255 and b<=255 then
        return Color3.fromRGB(r,g,b)
    end
    error("Use a hex color like #FF0000 or RGB like 255,0,0.")
end
local order = 0
local activeSectionRows
local function row(class, text)
    order = order + 1
    local obj = make(class, {LayoutOrder=order, Size=UDim2.new(1,-6,0,34), BackgroundColor3=Color3.fromRGB(37,43,60), BorderSizePixel=0, Text=text, TextColor3=Color3.new(1,1,1), TextSize=14, Font=Enum.Font.Gotham}, scroll)
    make("UICorner", {CornerRadius=UDim.new(0,9)}, obj)
    if class~="TextLabel" then make("UIStroke",{Color=Color3.fromRGB(87,81,111),Transparency=0.65},obj) end
    if activeSectionRows then table.insert(activeSectionRows,obj) end
    return obj
end
local function section(text)
    activeSectionRows=nil
    local sectionRows={}
    local expanded=true
    local label = row("TextButton", "-  "..text)
    label.Size=UDim2.new(1,-6,0,38)
    label.BackgroundColor3=Color3.fromRGB(48,38,72)
    label.TextXAlignment=Enum.TextXAlignment.Left
    label.TextColor3=Color3.fromRGB(214,199,255)
    label.Font=Enum.Font.GothamBold
    label.TextSize=12
    label.AutoButtonColor=false
    make("UIPadding",{PaddingLeft=UDim.new(0,12)},label)
    label.Activated:Connect(function()
        expanded=not expanded
        label.Text=(expanded and "-  " or "+  ")..text
        for _,item in ipairs(sectionRows) do
            if expanded then
                item.Visible=item:GetAttribute("AuraSectionVisible")~=false
            else
                item:SetAttribute("AuraSectionVisible",item.Visible)
                item.Visible=false
            end
        end
    end)
    activeSectionRows=sectionRows
end
local function input(placeholder)
    local box = row("TextBox", "")
    box.PlaceholderText=placeholder
    box.ClearTextOnFocus=false
    box.PlaceholderColor3=Color3.fromRGB(148,144,166)
    box.BackgroundColor3=Color3.fromRGB(23,25,36)
    box.Focused:Connect(function() Tween:Create(box,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(35,30,52)}):Play() end)
    box.FocusLost:Connect(function() Tween:Create(box,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(23,25,36)}):Play() end)
    return box
end
local function button(text, fn)
    local b = row("TextButton", text)
    local busy = false
    b.AutoButtonColor=false
    local scale=make("UIScale",{Scale=1},b)
    b.MouseEnter:Connect(function() Tween:Create(b,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(73,56,110)}):Play() end)
    b.MouseLeave:Connect(function() Tween:Create(b,TweenInfo.new(0.12),{BackgroundColor3=Color3.fromRGB(37,43,60)}):Play() end)
    b.MouseButton1Down:Connect(function() Tween:Create(scale,TweenInfo.new(0.08),{Scale=0.975}):Play() end)
    b.MouseButton1Up:Connect(function() Tween:Create(scale,TweenInfo.new(0.12,Enum.EasingStyle.Back),{Scale=1}):Play() end)
    b.Activated:Connect(function()
        if busy then return end
        busy=true
        local ok, err = pcall(fn)
        if not ok then report(tostring(err):gsub("^.-:%d+: ", "")) end
        busy=false
    end)
    return b
end
local function root()
    local char = player.Character
    local r = char and char:FindFirstChild("HumanoidRootPart")
    assert(r, "Wait for your character to spawn.")
    return r
end
local function username(box)
    local name=box.Text:match("^%s*(.-)%s*$"):gsub("^@", "")
    assert(#name>0 and #name<=20 and name:match("^[%w_]+$"), "Enter a Roblox username, not a display name.")
    return name
end
local function avatar(name)
    local id=Players:GetUserIdFromNameAsync(name)
    local description=Players:GetHumanoidDescriptionFromUserIdAsync(id)
    local model=Players:CreateHumanoidModelFromDescriptionAsync(description,Enum.HumanoidRigType.R15)
    description:Destroy()
    for _,obj in ipairs(model:GetDescendants()) do
        if obj:IsA("BaseScript") then obj:Destroy()
        elseif obj:IsA("BasePart") then
            obj.CanCollide=false; obj.CanTouch=false; obj.CanQuery=false
        end
    end
    model.HumanoidRootPart.Anchored=true
    model.Humanoid.DisplayName=name
    model.Humanoid.HealthDisplayType=Enum.HumanoidHealthDisplayType.AlwaysOff
    return model
end
local function ground(position)
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local exclusions={world}
    if player.Character then table.insert(exclusions,player.Character) end
    params.FilterDescendantsInstances=exclusions
    params.RespectCanCollide=true
    local hit=workspace:Raycast(position+Vector3.new(0,8,0),Vector3.new(0,-250,0),params)
    return hit and hit.Position or position-Vector3.new(0,3,0)
end
local function loadTrack(model,id,priority)
    local humanoid=model:FindFirstChildOfClass("Humanoid")
    local controller=humanoid or model:FindFirstChildOfClass("AnimationController") or make("AnimationController",{},model)
    local animator=controller:FindFirstChildOfClass("Animator") or make("Animator",{},controller)
    local animation=make("Animation",{AnimationId="rbxassetid://"..id},model)
    local track=animator:LoadAnimation(animation)
    track.Looped=true; track.Priority=priority
    return track
end
local function addTrail(actor)
    local assets=RS:FindFirstChild("Assets")
    local trails=assets and assets:FindFirstChild("Trails")
    local template=trails and trails:FindFirstChild("EternalTrail")
    local source=template and template:FindFirstChildWhichIsA("Trail",true)
    local r=actor.HumanoidRootPart
    local a=make("Attachment",{Position=Vector3.new(-0.65,0,0.6)},r)
    local b=make("Attachment",{Position=Vector3.new(0.65,0,0.6)},r)
    local trail=source and source:Clone() or make("Trail",{Color=ColorSequence.new(Color3.fromRGB(178,126,255)),Lifetime=0.3},r)
    trail.Attachment0=a; trail.Attachment1=b; trail.Enabled=true; trail.Parent=r
    return trail
end
local function clearScene()
    generation=generation+1
    if bot then bot:Destroy(); bot=nil end
    for model in pairs(spawnedEggs) do model:Destroy() end
    for _,nest in pairs(eggNests) do nest:Destroy() end
    eggNests={}
    spawnedEggs={}; egg=nil
end
local function restore()
    morphVersion=morphVersion+1
    local state=morphState
    morphState=nil
    if state then
        for _,connection in ipairs(state.connections or {}) do connection:Disconnect() end
        for _,track in pairs(state.tracks or {}) do pcall(function() track:Stop(0.1); track:Destroy() end) end
        for part,value in pairs(state.hidden) do
            if part.Parent then part.LocalTransparencyModifier=value end
        end
        if state.humanoid.Parent then state.humanoid.DisplayDistanceType=state.nameDistance end
        if state.model then state.model:Destroy() end
        if state.character.Parent then task.defer(applyNameTag,state.character) end
    end
    return true
end
local function rootClearance(character,humanoid,rootPart)
    local leg=character:FindFirstChild("Left Leg")
    return humanoid.HipHeight+rootPart.Size.Y/2+
        (humanoid.RigType==Enum.HumanoidRigType.R6 and leg and leg.Size.Y or 0)
end
